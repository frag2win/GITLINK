#!/bin/sh

# pre-receive hook
# Intercepts pushes to validate branch protections via the API server.
# Communicates exclusively over Unix Domain Socket to maintain isolation.

AUTH_SOCKET="/run/git/auth.sock"
AUTH_URL="http://localhost/hooks/pre-receive"
REPO_NAME=$(basename "$PWD" .git)

while read oldrev newrev refname; do
    # Only validate branch pushes, skip tags for now
    case "$refname" in
        refs/heads/*)
            BRANCH=${refname#refs/heads/}
            
            # Make HTTP POST to the api-server via Unix Socket
            # Use curl --unix-socket to hit the isolated auth socket
            HTTP_CODE=$(curl -s --unix-socket "$AUTH_SOCKET" \
                -H "Content-Type: application/json" \
                -d "{\"repo\": \"$REPO_NAME\", \"branch\": \"$BRANCH\", \"oldrev\": \"$oldrev\", \"newrev\": \"$newrev\"}" \
                "$AUTH_URL" | grep -o '"allowed":\s*true')
            
            if [ -z "$HTTP_CODE" ]; then
                echo "GL-HOOK-ERR: Push to branch '$BRANCH' is rejected by branch protection rules." >&2
                echo "GL-HOOK-ERR: You must create a Pull Request." >&2
                exit 1
            fi
            ;;
    esac
done

exit 0
