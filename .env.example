# =============================================================================
# Environment Variables — Local-First P2P Git Hosting Platform
# =============================================================================
# Copy this file to .env and adjust values for your local setup.
#
#   cp .env.example .env
#
# =============================================================================

# ---------------------------------------------------------------------------
# Paths — Host directories mounted into containers
# ---------------------------------------------------------------------------

# Directory where bare git repositories are stored on the host.
# Mounted into the git-server container at /repos.
HOST_REPOS_PATH=./data/repos

# Directory for the API server's SQLite database on the host.
# Mounted into the api-server container at /data.
HOST_DB_PATH=./data/db

# ---------------------------------------------------------------------------
# API Server
# ---------------------------------------------------------------------------

# Port the API server listens on (mapped from the container to the host).
API_PORT=3000

# ---------------------------------------------------------------------------
# libp2p Node
# ---------------------------------------------------------------------------

# Path to the ed25519 peer identity key inside the container.
# The key is persisted in the peer-identity Docker volume.
PEER_KEY_PATH=/identity/peer.key

# libp2p swarm listen port on the host (host networking mode).
P2P_LISTEN_PORT=4001

# Enable mDNS-based LAN peer discovery (true | false).
MDNS_ENABLED=true

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------

# Log verbosity: trace | debug | info | warn | error
LOG_LEVEL=info
